<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trekhive</title>
    <link rel="stylesheet" href="/app.css">
</head>
<body class="flex flex-col min-h-screen bg-slate-50 ">
   <%- include('../partials/navbar') %> <!-- to include ejs file -->

   <main class="grow max-w-7xl mx-auto px-2 sm:px-4 lg:px-6 w-full py-6">
    <%= success %>
