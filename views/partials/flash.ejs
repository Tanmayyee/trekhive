<!-- Floating Flash Messages (Top Right) -->
<div class="fixed top-20 right-4 z-50 flex flex-col gap-3 w-full max-w-sm pointer-events-none px-4 sm:px-0">
    
    <% if(success && success.length) { %>
        <!-- Success Toast -->
        <div id="flash-alert-success" 
             class="pointer-events-auto flex items-center justify-between p-4 bg-white border border-emerald-100 rounded-xl shadow-xl shadow-emerald-500/10 transform transition-all duration-300 translate-x-0 opacity-100">
            
            <div class="flex items-center gap-3">
                <div class="flex items-center justify-center p-2 bg-emerald-50 rounded-full text-emerald-500 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div class="text-sm font-semibold text-slate-800">
                    <%= success %>
                </div>
            </div>

            <button type="button" onclick="closeAlert('flash-alert-success')" 
                class="p-1.5 ml-4 shrink-0 text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors focus:outline-none">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    <% } %>

    <% if(error && error.length) { %>
        <!-- Error Toast -->
        <div id="flash-alert-error" 
             class="pointer-events-auto flex items-center justify-between p-4 bg-white border border-rose-100 rounded-xl shadow-xl shadow-rose-500/10 transform transition-all duration-300 translate-x-0 opacity-100">
            
            <div class="flex items-center gap-3">
                <div class="flex items-center justify-center p-2 bg-rose-50 rounded-full text-rose-500 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div class="text-sm font-semibold text-slate-800">
                    <%= error %>
                </div>
            </div>

            <button type="button" onclick="closeAlert('flash-alert-error')" 
                class="p-1.5 ml-4 shrink-0 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors focus:outline-none">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    <% } %>

</div>

<!-- Smooth Slide-Out Script -->
<script>
    function closeAlert(id) {
        const alertBox = document.getElementById(id);
        if (alertBox) {
            // Slide out to the right and fade
            alertBox.style.transform = 'translateX(100%)';
            alertBox.style.opacity = '0';
            setTimeout(() => {
                alertBox.style.height = '0';
                alertBox.style.margin = '0';
                alertBox.style.padding = '0';
                alertBox.style.borderWidth = '0';
            }, 300);
            setTimeout(() => alertBox.remove(), 600); 
        }
    }

    // Auto dismiss toasts after 4 seconds
    setTimeout(() => {
        closeAlert('flash-alert-success');
        closeAlert('flash-alert-error');
    }, 4000);
</script>