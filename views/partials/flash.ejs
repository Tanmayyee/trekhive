<link rel="stylesheet" href="/flash.css">

<!-- Flash Messages -->
<div class="fixed top-6 left-0 right-0 z-9999 flex flex-col items-center gap-3 pointer-events-none px-4">
    
    <% if(success && success.length) { %>
        <!-- Success Toast -->
        <div id="flash-alert-success" 
             class="toast-enter relative overflow-hidden pointer-events-auto flex items-center justify-between py-3 px-4 sm:px-5 bg-slate-900 text-white rounded-full shadow-2xl shadow-slate-900/20 border border-slate-700 w-auto min-w-75 max-w-md">
            
            <div class="flex items-center gap-3">
                <div class="flex items-center justify-center text-emerald-400 shrink-0">
                    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div class="text-sm sm:text-base font-medium tracking-wide pr-4">
                    <%= success %>
                </div>
            </div>

            <button type="button" onclick="closeAlert('flash-alert-success')" 
                class="p-1 shrink-0 text-slate-400 hover:text-white rounded-full transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
            
            <!-- Countdown Progress Bar (3 seconds) -->
            <div class="absolute bottom-0 left-0 h-0.75 bg-emerald-500 toast-progress-success"></div>
        </div>
    <% } %>

    <% if(error && error.length) { %>
        <!-- Error Toast -->
        <div id="flash-alert-error" 
             class="toast-enter relative overflow-hidden pointer-events-auto flex items-center justify-between py-3 px-4 sm:px-5 bg-slate-900 text-white rounded-full shadow-2xl shadow-slate-900/20 border border-slate-700 w-auto min-w-75 max-w-md">
            
            <div class="flex items-center gap-3">
                <div class="flex items-center justify-center text-rose-400 shrink-0">
                    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div class="text-sm sm:text-base font-medium tracking-wide pr-4">
                    <%= error %>
                </div>
            </div>

            <button type="button" onclick="closeAlert('flash-alert-error')" 
                class="p-1 shrink-0 text-slate-400 hover:text-white rounded-full transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>

            <!-- Countdown Progress Bar (4 seconds) -->
            <div class="absolute bottom-0 left-0 h-0.75 bg-rose-500 toast-progress-error"></div>
        </div>
    <% } %>

</div>

<!-- Smooth Slide-Up Script -->
<script>
    function closeAlert(id) {
        const alertBox = document.getElementById(id);
        if (alertBox) {
            // Slide up and fade out smoothly
            alertBox.style.transition = 'all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1)';
            alertBox.style.transform = 'translateY(-150%) scale(0.9)';
            alertBox.style.opacity = '0';
            
            setTimeout(() => {
                alertBox.remove();
            }, 300); 
        }
    }

    setTimeout(() => {
        closeAlert('flash-alert-success');
    }, 3000);

    setTimeout(() => {
        closeAlert('flash-alert-error');
    }, 4000);
</script>