<% layout('/layout/boilerplate') %>

<!-- Header Section -->
<div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mt-2 border-b border-slate-200/80 pb-6">
    <div class="max-w-2xl">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight mb-2">
            Explore Treks.
        </h1>
        <p class="text-slate-500 font-medium text-sm sm:text-base leading-relaxed max-w-xl">
            Escape the ordinary.
        </p>
    </div>

    <a href="/listing/new" class="group shrink-0 inline-flex items-center justify-center gap-2 bg-slate-900 text-white hover:bg-black active:scale-95 pl-3 pr-5 py-2.5 rounded-full text-sm font-semibold tracking-wide transition-all duration-300 shadow-sm hover:shadow-xl hover:shadow-slate-900/20 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2">
        <div class="flex items-center justify-center bg-white/20 rounded-full p-1.5 transition-transform duration-300 group-hover:rotate-90">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4 text-white" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
        </div>
        New Trek
    </a>
</div>

<!-- Cluster Map -->
<div class="mb-10 w-full h-75 md:h-87.5 lg:h-100 rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-slate-100 relative z-0">
    <div id="map" class="w-full h-full touch-none"></div>
</div>

<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-5 lg:gap-6 pb-12">
    <% for(let list of listings){ %>
        <a href="/listing/<%= list._id %>"
            class="group block relative isolate aspect-3/4 sm:aspect-4/5 w-full rounded-2xl sm:rounded-3xl overflow-hidden bg-slate-900 shadow-sm transition-all duration-500 hover:shadow-xl hover:shadow-slate-900/20 hover:-translate-y-1 cursor-pointer focus:outline-none focus:ring-4 focus:ring-slate-900/20 transform-gpu [-webkit-mask-image:-webkit-radial-gradient(white,black)]">

            <img src="<%= list.image[0].url.replace('/upload/', '/upload/w_600,q_auto,f_auto/') %>" alt="<%= list.title %>"
                class="absolute inset-0 w-full h-full object-cover will-change-transform transform-gpu backface-hidden transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] group-hover:scale-105">

            <!-- Subtle baseline gradient -->
            <div class="absolute inset-0 bg-linear-to-t from-slate-950/80 via-slate-950/20 to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-95">
            </div>

            <div class="absolute top-2.5 left-2.5 sm:top-4 sm:left-4 z-10">
                <div class="backdrop-blur-md bg-black/30 border border-white/20 text-white px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full inline-flex items-center gap-1 shadow-md">
                    <svg xmlns="http://www.w3.org/2000/svg"
                        class="h-2.5 w-2.5 sm:h-3 sm:w-3 text-white drop-shadow-sm" viewBox="0 0 20 20"
                        fill="currentColor">
                        <path fill-rule="evenodd"
                            d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                            clip-rule="evenodd" />
                    </svg>
                    <span class="text-[9px] sm:text-[10px] text-white font-bold tracking-wider uppercase truncate max-w-24 sm:max-w-32 drop-shadow-sm leading-none pt-px">
                        <%= list.location %>
                    </span>
                </div>
            </div>

            <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4 z-10 flex flex-col justify-end">

                <!-- Title -->
                <div class="transform transition-transform duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] md:group-hover:-translate-y-1">
                    <h2 class="text-sm sm:text-lg lg:text-xl font-bold text-white leading-tight line-clamp-2 drop-shadow-md">
                        <%= list.title %>
                    </h2>
                </div>

                <!-- Mobile-Friendly Action Link -->
                <div class="overflow-hidden mt-1 sm:mt-1.5">
                    <div class="flex items-center gap-1.5 text-white/90 font-bold text-[10px] sm:text-[11px] uppercase tracking-wider transform transition-all duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] 
                            translate-y-0 opacity-100 
                            md:translate-y-4 md:opacity-0 md:group-hover:translate-y-0 md:group-hover:opacity-100">
                        <span>Explore</span>
                        <svg class="w-3 h-3 transform group-hover:translate-x-1 transition-transform duration-300"
                            fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                                d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </div>
                </div>

            </div>
        </a>
    <% } %>
</div>

<%- "<script>" %>
const maptilerApiKey = "<%- process.env.MAPTILER_API_KEY %>";
const listings = {
  type: "FeatureCollection",
  features: <%- JSON.stringify(
    listings.map(listing => ({
      type: "Feature",
      geometry: listing.geometry,
      properties: { popUpMarkup: listing?.properties?.popUpMarkup }
    }))
  ) %>
};
<%- "</script>" %>

<script src="/clusterMap.js"></script>