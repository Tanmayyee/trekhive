<% layout('/layout/boilerplate') %>

   <!-- header -->
    <div class="mb-10 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 sm:gap-0">

        <div>
            <h1 class="text-3xl sm:text-4xl font-extrabold uppercase text-gray-900 tracking-tight drop-shadow-sm">
                Explore Treks
            </h1>

            <svg width="120" height="10" viewBox="0 0 120 10" fill="none" class="mt-2 opacity-80" aria-hidden="true">
                <path d="M1 5C10 1 15 9 24 5C33 1 38 9 47 5C56 1 61 9 70 5C79 1 84 9 93 5C102 1 107 9 116 5"
                    stroke="currentColor" class="text-gray-900" stroke-width="2" stroke-linecap="round" />
            </svg>
        </div>

        <a href="/listing/new"
            class="inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-full px-6 py-2.5 transition-all duration-300 shadow-md hover:shadow-lg active:scale-95 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
            Add new Trek
        </a>
    </div>

    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        <% for(let list of listings){ %>
            <!-- card container -->
                <div class="group flex flex-col bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden transition-all duration-500 ease-out hover:-translate-y-2 hover:border-sky-500/40 h-full">
                   <!-- img section -->
                    <div class="relative w-full h-72 overflow-hidden shrink-0 bg-slate-950">
                        <img src="<%= list.image %>" alt="random image" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110">
                    </div>
                </div>
                <% } %>
    </div>
            
        