<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrekHive | Explore</title>
    <link rel="stylesheet" href="/app.css">
</head>

<body>
    <main class="p-2">
        <h1 class="text-3xl font-bold uppercase">running</h1>
        <ul class="list-disc pl-5">
            <% for(let list of listings){ %>
                <li>
                    <a href="/listing/<%= list._id %>" class="underline text-blue-500"><%= list.title %></a>
                </li>
                <% } %>
        </ul>
    </main>

</body>

</html>