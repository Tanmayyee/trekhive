<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1 class="text-3xl font-bold uppercase">Edit-</h1>
    <form action="/listing/<%= listing._id %>?_method=PUT" method="POST">
        <div class="mb-2">
            <label for="title" id="title">Title:</label>
            <input type="text" name="listing[title]" id="title" class="border" value="<%= listing.title %>">
        </div>
        <div>
            <label for="location" id="location">Location:</label>
            <input type="text" name="listing[location]" id="location" class="border" value="<%= listing.location %>">
        </div>
        <br>
        <button class="border bg-slate-200 py-1 px-2 "> Update </button>
        <br>
        <a href="/listing">Cancel</a>
    </form>
    
</body>
</html>