<% layout('/layout/boilerplate') %>

    <div class="flex items-center justify-center px-4 sm:px-6 lg:px-8 py-4 min-h-[80vh]">

        <div class="max-w-xl w-full bg-white border border-slate-200 border-t-4 border-t-blue-500 rounded-2xl shadow-xl shadow-slate-900/5 p-5 sm:p-6 transition-all duration-300">

            <!-- Header -->
            <div class="mb-5 text-center sm:text-left">
                <h1 class="text-xl sm:text-2xl font-extrabold uppercase text-slate-900 tracking-tight">
                    Edit <%= listing.title%>
                </h1>
                <p class="text-xs sm:text-sm text-slate-500 mt-1">Update the details below to modify this adventure on Trekhive.</p>
            </div>
            
            <!-- Form -->
            <form action="/listing/<%= listing._id %>?_method=PUT" method="POST" novalidate enctype="multipart/form-data" class="needs-validation group flex flex-col gap-4">
                
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <!-- Title -->
                  <div>
                      <label for="title" class="block text-[13px] font-bold text-slate-700 mb-1.5">
                          Trek Title
                      </label>
                      <input type="text" name="listing[title]" id="title" value="<%= listing.title %>" required
                          class="peer w-full px-3.5 py-2 rounded-lg border border-slate-300 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all duration-200 group-[.was-validated]:invalid:border-rose-500 group-[.was-validated]:invalid:focus:ring-rose-500 group-[.was-validated]:valid:border-emerald-500 group-[.was-validated]:valid:focus:ring-emerald-500">
                      <!-- Error-->
                      <p class="hidden group-[.was-validated]:peer-invalid:block text-[11px] text-rose-500 mt-1 font-medium">Please provide a valid trek title.</p>
                  </div>

                  <!-- Location -->
                  <div>
                      <label for="location" class="block text-[13px] font-bold text-slate-700 mb-1.5">
                          Location
                      </label>
                      <input type="text" name="listing[location]" id="location" value="<%= listing.location %>" required
                          class="peer w-full px-3.5 py-2 rounded-lg border border-slate-300 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all duration-200 group-[.was-validated]:invalid:border-rose-500 group-[.was-validated]:invalid:focus:ring-rose-500 group-[.was-validated]:valid:border-emerald-500 group-[.was-validated]:valid:focus:ring-emerald-500">
                      <p class="hidden group-[.was-validated]:peer-invalid:block text-[11px] text-rose-500 mt-1 font-medium">Location cannot be empty.</p>
                  </div>
              </div>

                <!-- Image -->
                <div>
                    <label class="block text-[13px] font-bold text-slate-700 mb-1.5">
                        Add New Images <span class="font-normal text-slate-500">(Max 5 total, up to 10MB each)</span>
                    </label>
                    
                    <div class="flex flex-col sm:flex-row items-start gap-4">
                        <input type="file" name="listing[image]" id="image-upload" multiple accept="image/*" class="hidden" data-existing="<%= listing.image ? listing.image.length : 0 %>">
                        
                        <label for="image-upload" class="shrink-0 inline-flex items-center justify-center px-4 py-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer shadow-sm transition-all focus-within:ring-2 focus-within:ring-slate-900 active:scale-95">
                            <svg class="w-4 h-4 mr-2 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                            Choose Images
                        </label>
                        <p class="hidden group-[.was-validated]:peer-invalid:block text-[11px] text-rose-500 mt-1 font-medium">You must upload at least one image.</p>
                    </div>

                    <!-- preview image -->
                    <div class="flex flex-wrap gap-4 mt-3" id="existing-images-container">
                        <% if(listing.image && listing.image.length > 0) { %>
                            <% listing.image.forEach(function(img,i) { %>
                                <div class="relative mt-2" id="existing-img-box-<%=i%>">
                                    
                                    <!-- Image Box -->
                                    <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-md overflow-hidden border border-slate-200 shadow-sm relative">
                                        <img src="<%= img.url %>" class="w-full h-full object-cover">
                                    </div>
                                    
                                    <input type="checkbox" id="image-<%=i%>" name="deleteImages[]" value="<%= img.filename %>" class="hidden delete-checkbox">
                                    
                                    <button type="button" onclick="removeExistingImage('image-<%=i%>', 'existing-img-box-<%=i%>')" 
                                        class="absolute -top-2 -right-2 bg-rose-500 hover:bg-rose-600 text-white rounded-full w-5 h-5 flex items-center justify-center shadow-md transition-all hover:scale-110 focus:outline-none cursor-pointer z-10">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
                                        </svg>
                                    </button>

                                </div>
                            <% }) %>
                        <% } %>
                    </div>

                    <!-- New Uploads Container -->
                    <div id="image-preview-container" class="flex flex-wrap gap-4 empty:hidden">
                    </div>
                    
                    <!-- Error -->
                    <p id="image-error" class="hidden text-[11px] text-rose-500 mt-2 font-medium"></p>

                </div>

                <!-- Estimated Cost -->
                <div>
                    <label for="price" class="block text-[13px] font-bold text-slate-700 mb-1.5">
                        Estimated Cost
                    </label>   
                    
                    <div class="group/price">
                        <div class="flex rounded-lg border border-slate-300 focus-within:ring-2 focus-within:ring-slate-900 focus-within:border-transparent transition-all duration-200 group-[.was-validated]:group-has-invalid/price:border-rose-500 group-[.was-validated]:group-has-invalid/price:focus-within:ring-rose-500 group-[.was-validated]:group-has-valid/price:border-emerald-500 group-[.was-validated]:group-has-valid/price:focus-within:ring-emerald-500">
                            
                            <span class="inline-flex items-center px-3.5 py-2 text-sm bg-slate-100 text-slate-600 font-bold border-r border-slate-300 rounded-l-lg transition-colors group-[.was-validated]:group-has-invalid/price:border-rose-500 group-[.was-validated]:group-has-valid/price:border-emerald-500 group-[.was-validated]:group-has-invalid/price:text-rose-600">
                                ₹
                            </span>
                            
                            <input type="number" name="listing[price]" id="price" value="<%= listing.price %>" min="1" required
                                class="w-full px-3.5 py-2 rounded-r-lg text-sm text-slate-900 placeholder-slate-400 focus:outline-none">
                        </div>

                        <!-- Price Error Message -->
                        <p class="hidden group-[.was-validated]:group-has-invalid/price:block text-[11px] text-rose-500 mt-1 font-medium">Please enter a valid cost greater than 0.</p>
                    </div>

                    <div class="mt-1.5 flex items-start gap-1.5 group-[.was-validated]:group-has-invalid/price:hidden">
                        <svg class="w-3.5 h-3.5 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <p class="text-[12px] text-slate-500 leading-tight">
                           On-ground costs only (stay, food). <span class="font-bold text-slate-600">No travel/flight expenses.</span>                        
                        </p>
                    </div>
                </div>

                <!-- Description -->
                <div>
                    <label for="description" class="block text-[13px] font-bold text-slate-700 mb-1.5">
                        Description <span class="font-normal text-slate-500">(optional)</span> 
                    </label>
                    <textarea name="listing[description]" id="description" rows="3" 
                        placeholder="Describe the trek highlights, difficulty, and itinerary..."
                        class="peer w-full px-3.5 py-2 rounded-lg border border-slate-300 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all duration-200 group-[.was-validated]:invalid:border-rose-500 group-[.was-validated]:invalid:focus:ring-rose-500 group-[.was-validated]:valid:border-emerald-500 group-[.was-validated]:valid:focus:ring-emerald-500"><%= listing.description %></textarea>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col-reverse sm:flex-row items-center justify-between gap-3 pt-4 mt-1 border-t border-slate-100">
                    <a href="/listing/<%= listing._id %>"
                        class="w-full sm:w-auto text-center px-5 py-2 text-sm font-semibold text-slate-600 hover:text-slate-900 transition-colors duration-200">
                        Cancel
                    </a>

                    <button type="submit"
                        class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold cursor-pointer rounded-xl shadow-md hover:shadow-lg active:scale-95 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2">
                        Update Trek
                    </button>
                </div>

            </form>
        </div>
    </div>

<script src="/image.js"></script>