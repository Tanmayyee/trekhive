<% layout('/layout/boilerplate') %>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">

        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-6 mb-8 border-b border-slate-200">
            <div>
                <div class="flex items-center gap-3 mb-2">
                    <div
                        class="w-10 h-10 rounded-full bg-slate-900 text-white flex items-center justify-center shadow-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10">
                            </path>
                        </svg>
                    </div>
                    <span class="text-sm font-bold text-slate-500 uppercase tracking-widest">Host Dashboard</span>
                </div>
                <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
                    Manage Treks
                </h1>

                <p class="mt-2 text-sm font-semibold text-slate-500">
                    <% if(myTreks && myTreks.length> 0) { %>
                        You are currently hosting <span class="text-slate-900">
                            <%= myTreks.length %>
                        </span> active <%= myTreks.length===1 ? 'trek' : 'treks' %>.
                            <% } else { %>
                                View and manage your hosted adventures.
                                <% } %>
                </p>
            </div>

            <% if(myTreks && myTreks.length> 0) { %>
                <a href="/listing/new"
                    class="group shrink-0 inline-flex items-center justify-center gap-2 bg-slate-900 text-white hover:bg-black active:scale-95 pl-3 pr-5 py-2.5 rounded-full text-sm font-semibold tracking-wide transition-all duration-300 shadow-sm hover:shadow-xl hover:shadow-slate-900/20 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2">
                    <div
                        class="flex items-center justify-center bg-white/20 rounded-full p-1.5 transition-transform duration-300 group-hover:rotate-90">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4 text-white"
                            viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd"
                                d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
                                clip-rule="evenodd" />
                        </svg>
                    </div>
                    New Trek
                </a>
                <% } %>
        </div>

        <!-- The Dashboard List -->
        <% if(myTreks && myTreks.length> 0) { %>
            <div class="flex flex-col gap-5 pb-16">
                <% for(let list of myTreks.slice().reverse()){ %>
                    <div
                        class="group relative bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-[0_8px_16px_rgba(0,0,0,0.06)] hover:border-slate-300 transition-all duration-300 flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-6 cursor-pointer">

                        <a href="/listing/<%= list._id %>" class="absolute inset-0 z-10 rounded-2xl"
                            aria-label="View <%= list.title %>"></a>

                        <div class="flex items-center gap-4 sm:gap-6 flex-1 min-w-0">
                                <% if(list.image && list.image.length>0) { %>
                                     <div
                                class="relative w-24 h-24 sm:w-44 sm:h-32 rounded-xl overflow-hidden bg-slate-100 shrink-0 border border-slate-200 shadow-inner">
                                <img src="<%= list.image[0].url.replace('/upload/', '/upload/w_600,q_auto,f_auto/')  %>" alt="<%= list.title %>"
                                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                                     </div>
                                <% }else { %>
                                       <div
                                class="relative w-24 h-24 sm:w-44 sm:h-32 rounded-xl overflow-hidden bg-slate-100 shrink-0 border border-slate-200 shadow-inner">
                                <img src="https://img.icons8.com/color/1200/no-image.jpg" alt="no image"
                                 class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                                </div>
                                <% } %>        
                           

                            <div class="flex-1 min-w-0 py-1">
                                <div class="flex items-center gap-1.5 mb-1.5">
                                    <svg class="w-4 h-4 text-rose-500 shrink-0" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z">
                                        </path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                    <span class="text-xs font-bold text-slate-500 uppercase tracking-wide truncate">
                                        <%= list.location %>
                                    </span>
                                </div>

                                <h2
                                    class="text-lg sm:text-xl font-extrabold text-slate-900 leading-tight mb-2 line-clamp-2">
                                    <%= list.title %>
                                </h2>

                                <div class="text-sm font-bold text-slate-900">
                                    ₹<%= list.price || "5,000" %> <span class="text-slate-400 font-medium">/ week</span>
                                </div>
                            </div>
                        </div>

                        <div
                            class="relative z-20 grid grid-cols-2 sm:flex sm:items-center gap-2 sm:gap-3 border-t sm:border-t-0 border-slate-100 pt-4 sm:pt-0 shrink-0 mt-1 sm:mt-0">

                            <a href="/listing/<%= list._id %>"
                                class="inline-flex items-center justify-center px-4 py-2.5 sm:py-2 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-slate-900 text-sm font-bold rounded-xl transition-all shadow-sm">
                                View
                            </a>

                            <a href="/listing/<%= list._id %>/edit"
                                class="inline-flex items-center justify-center px-4 py-2.5 sm:py-2 bg-slate-900 text-white hover:bg-slate-800 text-sm font-bold rounded-xl transition-all shadow-sm">
                                Edit
                            </a>

                            <form id="delete-trek-form" action="/listing/<%= list._id %>?_method=DELETE&redirect=/listing/mytreks" method="POST"
                                class="m-0 col-span-2 sm:col-span-1 sm:w-auto">
                                <button type="button" onclick="showDeleteModal()"
                                    class="w-full inline-flex items-center justify-center px-4 py-2.5 sm:py-2 bg-white border border-rose-200 text-rose-600 hover:bg-rose-50 hover:text-rose-700 text-sm font-bold rounded-xl transition-all shadow-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-rose-200">
                                    Delete
                                </button>
                            </form>

                        </div>
                    </div>
                    <% } %>
            </div>
            <% } else { %>
                <div
                    class="w-full bg-slate-50/50 border-2 border-dashed border-slate-300 rounded-3xl p-10 sm:p-16 text-center flex flex-col items-center justify-center mt-4">
                    <div
                        class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center border border-slate-200 mb-5 shadow-sm">
                        <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10">
                            </path>
                        </svg>
                    </div>
                    <h3 class="text-xl sm:text-2xl font-black text-slate-900 mb-2">No active treks</h3>
                    <p class="text-sm sm:text-base text-slate-500 mb-6 max-w-md mx-auto">
                        Your dashboard is currently empty. Start hosting by creating your very first trek listing to
                        share with the community.
                    </p>
                    <a href="/listing/new"
                        class="inline-flex items-center justify-center px-6 py-3 sm:px-8 sm:py-3.5 bg-slate-900 text-white text-sm sm:text-base font-bold rounded-xl shadow-md hover:bg-slate-800 hover:-translate-y-0.5 transition-all duration-200 focus:ring-4 focus:ring-slate-200">
                        Create Your First Trek
                    </a>
                </div>
                <% } %>
    </div>


    <!-- Delete warning -->
    <div id="delete-modal" class="fixed inset-0 z-150 hidden bg-black/60 backdrop-blur-sm flex-col items-center justify-center p-4 transition-opacity duration-300 opacity-0" onclick="closeDeleteModal()">
        
        <div class="relative w-full max-w-sm bg-white rounded-2xl overflow-hidden shadow-2xl p-6 text-center transform scale-95 transition-transform duration-300" onclick="event.stopPropagation()">
            
            <div class="mx-auto flex items-center justify-center h-14 w-14 rounded-full bg-rose-100 mb-4 shadow-inner">
                <svg class="h-7 w-7 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1">Delete this trek?</h3>
            <p class="text-[13px] text-slate-500 mb-5 leading-relaxed">
                Are you sure? This action cannot be undone and all data will be permanently lost.
            </p>
            
            <div class="flex gap-2">
                <button type="button" onclick="closeDeleteModal()" 
                    class="w-full inline-flex justify-center items-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-[13px] font-bold text-slate-700 hover:bg-slate-50 hover:border-slate-400 focus:outline-none transition-all cursor-pointer">
                    Cancel
                </button>
                
                <button type="button" onclick="submitDeleteForm()" 
                    class="w-full inline-flex justify-center items-center rounded-xl border border-transparent bg-rose-600 px-4 py-2 text-[13px] font-bold text-white hover:bg-rose-700 focus:outline-none shadow-md hover:shadow-lg transition-all cursor-pointer">
                    Yes, Delete
                </button>
            </div>
        </div>
    </div>

    <script src="/myTrekScript.js"></script>