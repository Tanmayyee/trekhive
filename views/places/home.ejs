<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrekHive</title>
    <link rel="icon" type="image/png" href="/video/favicon-32x32.png?v=3">
    <link rel="apple-touch-icon" href="/video/favicon-32x32.png?v=3">
    <link rel="stylesheet" href="/app.css">
    <link rel="stylesheet" href="/home.css">

</head>

<body class="bg-slate-50 flex flex-col min-h-screen">

    <nav id="main-nav" class="absolute top-0 left-0 -mt-px pt-px z-50 w-full border-b border-transparent transition-all duration-300">
        <div id="nav-bg-base" class="absolute inset-0 w-full h-full pointer-events-none transition-colors duration-300"></div>
        <div id="nav-bg-gradient" class="hidden absolute inset-0 w-full h-full bg-linear-to-r from-black/80 via-black/35 to-black/80 pointer-events-none z-0"></div>
        
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="flex justify-between items-center h-16">

                <div class="shrink-0 flex items-center gap-2 group cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white group-hover:text-amber-400 transform group-hover:-translate-y-1 group-hover:scale-105 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m8 3 4 8 5-5 5 15H2L8 3z" />
                    </svg>

                    <a href="/home" class="text-xl sm:text-2xl font-extrabold tracking-tight">
                        <span class="text-white group-hover:text-amber-400 transition-colors duration-300">Trek</span><span class="text-amber-400 group-hover:text-white transition-colors duration-300">hive</span>
                    </a>
                </div>

                <div class="hidden md:flex md:space-x-2 items-center">
                    <a href="/home" class="group relative inline-flex items-center justify-center px-3 py-2 rounded-lg text-sm font-semibold text-white transition-colors duration-200">
                        <span>Home</span>
                        <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 flex items-center justify-center gap-1.5 h-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 scale-0 group-hover:scale-100 transition-transform duration-300 ease-out"></span>
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 scale-0 group-hover:scale-100 transition-transform duration-300 ease-out delay-75"></span>
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 scale-0 group-hover:scale-100 transition-transform duration-300 ease-out delay-150"></span>
                        </div>
                    </a>

                    <a href="/listing" class="group relative inline-flex items-center justify-center px-3 py-2 rounded-lg text-sm font-semibold text-white transition-colors duration-200">
                        <span>Explore</span>
                        <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 flex items-center justify-center gap-1.5 h-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 scale-0 group-hover:scale-100 transition-transform duration-300 ease-out"></span>
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 scale-0 group-hover:scale-100 transition-transform duration-300 ease-out delay-75"></span>
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 scale-0 group-hover:scale-100 transition-transform duration-300 ease-out delay-150"></span>
                        </div>
                    </a>

                    <div class="h-5 w-px bg-gray-400/50 mx-2"></div>

                    <% if(!currentUser) { %>
                        <a href="/login" class="group ml-2 inline-flex items-center justify-center text-slate-900 bg-white hover:-translate-y-0.5 hover:shadow-[0_0_15px_rgba(251,191,36,0.4)] active:scale-[0.98] active:translate-y-0 active:bg-slate-50 px-6 py-1.5 rounded-full text-sm font-bold tracking-wide transition-all duration-300">
                            Sign In
                        </a>
                    <% } else { %>
                        <div class="relative mr-1">
                            <button type="button" id="th-profile-btn" aria-haspopup="true" aria-expanded="false" class="flex items-center gap-2 pl-2 pr-3 py-1.5 rounded-full text-sm font-semibold text-slate-200 hover:bg-white/10 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400/70 cursor-pointer">
                                <span class="relative flex items-center justify-center h-7 w-7 rounded-full bg-white/10 border border-white/15">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-200" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M10 9a3.5 3.5 0 100-7 3.5 3.5 0 000 7zm-6.5 8a6.5 6.5 0 0113 0 .75.75 0 01-.75.75h-11.5A.75.75 0 013.5 17z" clip-rule="evenodd" />
                                    </svg>
                                    <span class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-green-500 border-2 border-gray-900"></span>
                                </span>
                                <span class="max-w-32 truncate">
                                    <%= currentUser.username || 'Account' %>
                                </span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                                </svg>
                            </button>

                            <div id="th-profile-dropdown" class="hidden opacity-0 translate-y-1 absolute right-0 mt-2 w-48 rounded-xl bg-gray-900/95 backdrop-blur-md border border-gray-700/60 shadow-xl py-1.5 transition-all duration-150 ease-out">
                                <a href="/listing/mytreks" class="block px-4 py-2.5 text-sm font-medium text-slate-200 hover:bg-white/5 hover:text-amber-400 transition-colors duration-150">My Treks</a>
                                <div class="my-1 h-px bg-gray-700/60"></div>
                                <a href="/logout" class="block px-4 py-2.5 text-sm font-medium text-slate-300 hover:bg-white/5 hover:text-white transition-colors duration-150">Log Out</a>
                            </div>
                        </div>

                        <a href="/listing/new" class="group ml-1 inline-flex items-center justify-center text-slate-900 bg-white hover:-translate-y-0.5 hover:shadow-[0_0_15px_rgba(251,191,36,0.4)] active:scale-[0.98] active:translate-y-0 active:bg-slate-50 pl-2 pr-5 py-1.5 rounded-full text-sm font-bold tracking-wide transition-all duration-300">
                            <div class="flex items-center justify-center bg-slate-100 rounded-full h-6 w-6 mr-2 transition-all duration-300 group-hover:rotate-90 group-hover:bg-amber-400 group-hover:scale-110">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-900 group-hover:text-white transition-colors duration-300" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            New Trek
                        </a>
                    <% } %>
                </div>

                <div class="flex md:hidden items-center">
                    <button type="button" id="mobile-menu-btn" class="text-slate-300 hover:text-white focus:outline-none rounded-full transition-all duration-300 cursor-pointer">
                        <span class="sr-only">Open main menu</span>
                        
                        <div id="menu-open-state" class="block">
                            <% if(!currentUser) { %>
                                <div class="hover:bg-white/10 focus:ring-2 focus:ring-amber-400 rounded-lg p-2">
                                    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                                    </svg>
                                </div>
                            <% } else { %>
                                <span class="relative flex items-center justify-center h-9 w-9 rounded-full bg-white/10 border border-white/15 focus:ring-2 focus:ring-amber-400">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-200" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M10 9a3.5 3.5 0 100-7 3.5 3.5 0 000 7zm-6.5 8a6.5 6.5 0 0113 0 .75.75 0 01-.75.75h-11.5A.75.75 0 013.5 17z" clip-rule="evenodd" />
                                    </svg>
                                    <span class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-[#6B8F71] border-2 border-gray-900"></span>
                                </span>
                            <% } %>
                        </div>

                        <div id="menu-close-state" class="hidden hover:bg-white/10 focus:ring-2 focus:ring-amber-400 rounded-lg p-2">
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </div>
                    </button>
                </div>
            </div>
        </div>

        <div id="mobile-menu" class="hidden md:hidden absolute top-full w-full left-0 bg-white/10 border-b border-gray-700/50 shadow-[0_10px_20px_-10px_rgba(0,0,0,0.9)] z-50 transform-gpu">
            <div class="absolute inset-0 w-full h-full bg-linear-to-r from-black/80 via-black/35 to-black/80 pointer-events-none z-0"></div>
            <div class="px-6 pt-2 pb-6 space-y-1 relative z-10 max-h-[60vh] overflow-y-auto overscroll-contain">
                <a href="/home" class="block text-center text-slate-300 hover:text-amber-400 hover:bg-white/5 px-4 py-3 border-b border-gray-700/50 text-base font-semibold transition-all duration-300">Home</a>
                <a href="/listing" class="block text-center text-slate-300 hover:text-amber-400 hover:bg-white/5 px-4 py-3 border-b border-gray-700/50 text-base font-semibold transition-all duration-300">Explore</a>

                <% if(currentUser) { %>
                    <a href="/listing/mytreks" class="block text-center text-slate-300 hover:text-amber-400 hover:bg-white/5 px-4 py-3 border-b border-gray-700/50 text-base font-semibold transition-all duration-300">My Treks</a>
                    <a href="/logout" class="block text-center text-slate-300 hover:text-amber-400 hover:bg-white/5 px-4 py-3 border-b border-gray-700/50 text-base font-semibold transition-all duration-300">Log Out</a>
                    <div class="pt-4">
                        <a href="/listing/new" class="group flex items-center justify-center w-full text-slate-900 bg-white hover:-translate-y-0.5 hover:shadow-[0_0_15px_rgba(251,191,36,0.4)] active:scale-[0.98] active:translate-y-0 active:bg-slate-50 px-4 py-3 rounded-xl text-base font-bold tracking-wide transition-all duration-300 shadow-md">
                            <div class="flex items-center justify-center bg-slate-100 rounded-full h-7 w-7 mr-3 transition-all duration-300 group-hover:rotate-90 group-hover:bg-amber-400 group-hover:scale-110">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-900 group-hover:text-white transition-colors duration-300" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            New Trek
                        </a>
                    </div>
                <% } else { %>
                    <div class="pt-4">
                        <a href="/login" class="flex items-center justify-center w-full text-slate-900 bg-white hover:-translate-y-0.5 hover:shadow-[0_0_15px_rgba(251,191,36,0.4)] active:scale-[0.98] active:translate-y-0 active:bg-slate-50 px-4 py-3 rounded-xl text-base font-bold tracking-wide transition-all duration-300 shadow-md">
                            Sign In
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </nav>

    <main class="grow">
        
        <div class="relative w-full min-h-screen flex flex-col items-center justify-center overflow-hidden rounded-b-4xl md:rounded-b-[4rem] bg-slate-900" style="-webkit-mask-image: -webkit-radial-gradient(white, black); mask-image: radial-gradient(white, black); backface-visibility: hidden;;">
            <video autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover mobile-video-pos md:object-center">
                <source src="/video/15493543-uhd_3840_2160_30fps.mp4" type="video/mp4">
            </video>

            <div class="absolute inset-0"></div>

            <div class="relative z-10 text-center px-4 max-w-4xl mx-auto mt-16">
                <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 reveal delay-100">
                    Welcome to <span class="text-amber-400">TrekHive</span>
                </h1>

                <p class="text-lg md:text-xl text-slate-200 mb-10 reveal delay-200">
                    Find your next adventure.
                </p>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-4 reveal delay-300">
                    <a href="/listing" class="w-full sm:w-auto px-8 py-3 bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold rounded-full transition-colors flex items-center justify-center gap-2">
                        Explore Treks
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                    </a>
                    <a href="/listing/new" class="w-full sm:w-auto px-8 py-3 bg-transparent border-2 border-white hover:bg-white hover:text-slate-900 text-white font-bold rounded-full transition-colors">
                        Add a Trek
                    </a>
                </div>
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
            <div class="text-center mb-12 reveal">
                <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">Why TrekHive?</h2>
                <p class="text-slate-500">Everything you need for your next trek.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                <div class="reveal delay-100">
                    <div class="bg-white p-6 rounded-2xl shadow-md border border-slate-100 hover:shadow-lg hover:-translate-y-1 transition-all h-full">
                        <div class="h-12 w-12 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2">Global Community</h3>
                        <p class="text-slate-500">Discover amazing places from around the world, shared by fellow travelers, and share your own adventures.</p>
                    </div>
                </div>

                <div class="reveal delay-200">
                    <div class="bg-white p-6 rounded-2xl shadow-md border border-slate-100 hover:shadow-lg hover:-translate-y-1 transition-all h-full">
                        <div class="h-12 w-12 rounded-xl bg-amber-400 text-slate-900 flex items-center justify-center mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2">Interactive Maps</h3>
                        <p class="text-slate-500">Explore places with interactive maps powered by MapTiler, and easily find destinations you want to visit.</p>
                    </div>
                </div>

                <div class="reveal delay-300">
                    <div class="bg-white p-6 rounded-2xl shadow-md border border-slate-100 hover:shadow-lg hover:-translate-y-1 transition-all h-full">
                        <div class="h-12 w-12 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2">Honest Reviews</h3>
                        <p class="text-slate-500">Read genuine reviews from fellow travelers and learn about the place, its highlights, and what to expect.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-24 reveal">
            <div class="relative w-full rounded-3xl overflow-hidden shadow-xl bg-slate-900" style="-webkit-mask-image: -webkit-radial-gradient(white, black); mask-image: radial-gradient(white, black); backface-visibility: hidden;">
                <img src="/video/back-view-hiker-watching-sunset-from-mountain.jpg" alt="Trekker looking at mountains" class="absolute inset-0 w-full h-full object-cover opacity-50">

                <div class="relative z-10 p-10 md:p-16 flex flex-col md:flex-row items-center justify-between gap-8">
                    <div class="text-center md:text-left">
                        <span class="inline-block bg-amber-500 text-slate-900 text-xs font-bold px-3 py-1 rounded-full mb-4 uppercase tracking-wide">
                            Explore. Discover. Share.
                        </span>
                        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                            Ready to explore?
                        </h2>
                        <p class="text-slate-300 max-w-md">
                            Discover amazing places, share your experiences, and add your own favorite destinations to TrekHive.
                        </p>
                    </div>

                    <div>
                        <% if(!currentUser) { %>
                            <a href="/register" class="inline-block px-8 py-3 bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold rounded-full transition-colors">
                                Join TrekHive
                            </a>
                        <% } else { %>
                            <a href="/listing/new" class="inline-block px-8 py-3 bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold rounded-full transition-colors">
                                Add a New Trek
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <footer class="bg-slate-950 border-t border-slate-800 mt-auto relative overflow-hidden text-slate-300">
        <div class="absolute inset-0 w-full h-full bg-linear-to-r from-black/80 via-black/35 to-black/80 pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 py-12 lg:py-16">

                <div class="flex flex-col gap-4 lg:col-span-1 reveal delay-100">
                    <a href="/" class="flex items-center gap-1.5 group cursor-pointer w-fit">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white group-hover:text-amber-400 transform group-hover:-translate-y-0.5 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m8 3 4 8 5-5 5 15H2L8 3z" />
                        </svg>
                        <span class="text-xl sm:text-2xl font-extrabold tracking-tight">
                            <span class="text-white group-hover:text-amber-400 transition-colors duration-300">Trek</span><span class="text-amber-400 group-hover:text-white transition-colors duration-300">hive</span>
                        </span>
                    </a>
                    <p class="text-sm text-slate-400 leading-relaxed max-w-xs">
                        <span class="text-slate-300 font-semibold italic">Escape the ordinary.</span>
                    </p>
                </div>

                <div class="reveal delay-200">
                    <h3 class="text-white font-bold tracking-wide uppercase text-sm mb-4">Project Links</h3>
                      <ul class="flex flex-col gap-2.5 text-sm font-medium">
                        <li><a href="/home" class="hover:text-amber-400 transition-colors duration-200">Home</a></li>
                        <li><a href="/listing" class="hover:text-amber-400 transition-colors duration-200">Explore Treks</a>
                        </li>
                        <li><a href="/listing/mytreks" class="hover:text-amber-400 transition-colors duration-200">My Treks</a></li>
                        <li><a href="/listing/new" class="hover:text-amber-400 transition-colors duration-200">Add a
                            Trek</a></li>
                      </ul>
                </div>

               <div class="reveal delay-300">
                   <h3 class="text-white font-bold tracking-wide uppercase text-sm mb-4">Tech Stack</h3>
                    <ul class="flex flex-col gap-2.5 text-sm font-medium text-slate-400">
                       <li class="flex items-center gap-2">
                           <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                           <span class="text-slate-300">Core:</span> Node.js, Express & EJS
                       </li>
                       <li class="flex items-center gap-2">
                           <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                           <span class="text-slate-300">Database:</span> MongoDB & Mongoose
                       </li>
                       <li class="flex items-center gap-2">
                           <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                           <span class="text-slate-300">Auth:</span> Passport.js & Sessions
                       </li>
                       <li class="flex items-center gap-2">
                           <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                           <span class="text-slate-300">Services:</span> Cloudinary & MapTiler
                       </li>
                    </ul>
                </div>

                <div class="reveal delay-400">
                    <h3 class="text-white font-bold tracking-wide uppercase text-sm mb-4">About the Developer</h3>
                    <p class="text-sm text-slate-400 mb-4 leading-relaxed">
                        Hi, I'm Tanmay. I'm currently focusing on full-stack development and building scalable applications.
