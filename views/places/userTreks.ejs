<% layout('/layout/boilerplate') %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    
    <a href="javascript:history.back()"
        class="group inline-flex items-center text-[13px] font-medium text-slate-500 hover:text-slate-900 transition-colors cursor-pointer">
        <svg class="w-3.5 h-3.5 mr-1.5 transition-transform duration-300 group-hover:-translate-x-1" fill="none"
            stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18">
            </path>
        </svg>
        Go Back
    </a>

    <!-- Header -->
    <div class="bg-slate-900 rounded-2xl p-8 text-center sm:text-left flex flex-col sm:flex-row items-center gap-6 shadow-lg">
        <div class="w-24 h-24 rounded-full bg-white text-slate-900 flex items-center justify-center text-4xl font-extrabold shadow-inner">
            <%= profileUser.username.charAt(0).toUpperCase() %>
        </div>
        <div>
            <h1 class="text-3xl font-extrabold text-white tracking-tight">@<%= profileUser.username %></h1>
            <p class="text-slate-300 mt-2 font-medium">
                <%= userTreks.length %> <%= userTreks.length === 1 ? 'Trek' : 'Treks' %> Listed
            </p>
        </div>
    </div>

    <!-- Treks -->
    <div>
        <h2 class="text-xl font-bold text-slate-900 mb-5">Places listed by <%= profileUser.username %></h2>
        
        <% if(userTreks.length === 0) { %>
            <div class="bg-slate-50 border border-slate-200 border-dashed rounded-xl p-10 text-center flex flex-col items-center">
                <svg class="w-12 h-12 text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
                <h3 class="text-base font-semibold text-slate-700">No treks listed yet</h3>
                <p class="text-sm text-slate-500 mt-1">This user hasn't shared any locations.</p>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <% for (let trek of userTreks) { %>
                    <a href="/listing/<%= trek._id %>" class="group block bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md hover:-translate-y-1 transition-all duration-300">
                        <!-- Image -->
                        <div class="aspect-video w-full overflow-hidden bg-slate-100 relative">
                            <% if(trek.image && trek.image.length > 0) { %>
                                <img src="<%= trek.image[0].url.replace('/upload/', '/upload/w_600,q_auto,f_auto/') %>" alt="<%= trek.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <% } else { %>
                                <div class="relative w-full h-full flex-[0_0_100%] flex flex-col items-center justify-center bg-slate-100 text-slate-500">
                                     <svg class="w-12 h-12 text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" 
                                         d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                     </path>
                                     </svg>
                                     <h3 class="text-base font-semibold text-slate-700">No Image Preview</h3>
                                     <p class="text-[10px] text-slate-500 mt-1">The owner hasn't uploaded any photos yet.</p>
                                </div>
                            <% } %>
                            <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-2.5 py-1 rounded-md text-[11px] font-bold text-slate-900 shadow-sm">
                                ₹<%= trek.price %>
                            </div>
                        </div>
                        
                        <!-- Details -->
                        <div class="p-4">
                            <h3 class="text-lg font-bold text-slate-900 mb-1 truncate"><%= trek.title %></h3>
                            <p class="text-[13px] text-slate-500 flex items-center truncate">
                                <svg class="w-3.5 h-3.5 mr-1 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                                <%= trek.location %>
                            </p>
                        </div>
                    </a>
                <% } %>
            </div>
        <% } %>
    </div>
</div>