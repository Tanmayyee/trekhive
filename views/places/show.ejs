<% layout('/layout/boilerplate') %>
    <link rel="stylesheet" href="/star.css">

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-5 space-y-5">

        <a href="/listing"
            class="group inline-flex items-center text-[13px] font-medium text-slate-500 hover:text-slate-900 transition-colors">
            <svg class="w-3.5 h-3.5 mr-1.5 transition-transform duration-300 group-hover:-translate-x-1" fill="none"
                stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18">
                </path>
            </svg>
            Explore all places
        </a>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">

            <!-- LEFT COLUMN -->
            <div class="lg:col-span-8 space-y-5">

                <!-- Image Carousel -->
                <div class="relative w-full rounded-xl overflow-hidden bg-slate-900 shadow-sm border border-slate-200 aspect-16/10 sm:aspect-video group"
                    id="image-carousel">

                    <div id="carousel-track"
                        class="flex w-full h-full transition-transform duration-300 ease-out will-change-transform"
                        style="transform: translate3d(0%, 0px, 0px);">
                      <% if(listing.image && listing.image.length>0) { %>

                        <% listing.image.forEach((img, index)=> { %>
                            <div
                                class="relative w-full h-full flex-[0_0_100%] overflow-hidden flex items-center justify-center">
                                <img src="<%= img.url %>"
                                    class="absolute inset-0 w-full h-full object-cover blur-xl opacity-40 scale-110 pointer-events-none"
                                    alt="">
                                <img src="<%= img.url %>" alt="<%= listing.title %> - image <%= index + 1 %>"
                                    class="relative w-full h-full cursor-pointer hover:scale-[1.02] transition-transform duration-500 ease-out z-10"
                                    onload="this.classList.add(this.naturalWidth > this.naturalHeight ? 'object-cover' : 'object-contain')"
                                    onclick="openLightbox(parseInt('<%= index %>', 10))">
                            </div>
                        <% }) %>

                      <% }else{ %>
                           <div class="relative w-full h-full flex-[0_0_100%] flex flex-col items-center justify-center bg-slate-100 text-slate-500">
                               <svg class="w-12 h-12 text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" 
                                         d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                   </path>
                               </svg>
                               <h3 class="text-base font-semibold text-slate-700">No Image Preview</h3>
                               <p class="text-[13px] text-slate-500 mt-1">The owner hasn't uploaded any photos yet.</p>
                           </div>
                        <% } %>
                    </div>

                    <% if (listing.image && listing.image.length> 1) { %>
                        <button onclick="prevSlide()" aria-label="Previous slide"
                            class="absolute left-3 top-1/2 -translate-y-1/2 z-20 bg-white/20 hover:bg-white/40 text-white p-2 rounded-full backdrop-blur-md transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-white/50 shadow-sm opacity-0 group-hover:opacity-100 focus:opacity-100">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
                            </svg>
                        </button>
                        <button onclick="nextSlide()" aria-label="Next slide"
                            class="absolute right-3 top-1/2 -translate-y-1/2 z-20 bg-white/20 hover:bg-white/40 text-white p-2 rounded-full backdrop-blur-md transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-white/50 shadow-sm opacity-0 group-hover:opacity-100 focus:opacity-100">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </button>

                        <div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex space-x-1.5 bg-black/50 px-2.5 py-1.5 rounded-full backdrop-blur-md pointer-events-auto">
                            <% listing.image.forEach((_, index)=> { %>
                                <button onclick="goToSlide(parseInt('<%= index %>', 10))"
                                    class="carousel-dot h-1 rounded-full transition-all duration-300 ease-out cursor-pointer focus:outline-none <%= index === 0 ? 'bg-white w-5' : 'bg-white/50 hover:bg-white/90 w-1' %>"
                                    aria-label="Go to slide <%= index + 1 %>"></button>
                                <% }) %>
                        </div>
                        <% } %>
                </div>

                <!-- Info & Pricing -->
                <div class="flex flex-col md:flex-row justify-between items-start gap-4 mt-5">
                    
                    <div class="flex flex-col gap-2 flex-1 min-w-0 pr-0 md:pr-4">
                        <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight uppercase wrap-break-word">
                            <%= listing.title %>
                        </h1>

                        <div class="flex items-start sm:items-center text-slate-700 font-medium text-sm sm:text-base">
                            <svg class="w-4 h-4 mr-1.5 text-rose-500 shrink-0 mt-0.5 sm:mt-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <span class="wrap-break-word"><%= listing.location %></span>
                        </div>

                        <div class="flex items-center text-sm sm:text-base">
                            <svg class="w-4 h-4 mr-1.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            <span class="text-slate-500 mr-1.5">Listed by</span>
                            <a href="/user/<%= listing.author.username %>" class="font-bold text-slate-900 hover:text-blue-600 hover:underline transition-colors cursor-pointer">
                               <%= listing.author.username %>
                            </a>
                        </div>
                    </div>

                    <!-- Pricing & Note -->
                    <div class="flex flex-col items-start md:items-end shrink-0 md:max-w-64 mt-2 md:mt-0">
                        <div class="flex items-baseline gap-1 ">
                            <span class="text-2xl font-bold text-slate-900 tracking-tight">₹<%= listing.price || "5,000" %></span>
                            <span class="text-[13px] font-medium text-slate-500 whitespace-nowrap">avg / week</span>
                        </div>

                        <div class="flex items-start md:items-start md:justify-end gap-1 text-[11px] text-slate-500 mt-0.5">
                            <svg class="w-3 h-3 shrink-0 text-amber-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <p class="leading-snug text-left md:text-right">
                                Covers average stay & food. Travel excluded.
                            </p>
                        </div>
                    </div>
                </div>
                
                <!-- Description Section -->
                <%if(listing.description && listing.description.trim() !=='')  { %>
                <div>
                    <h2 class="text-lg font-bold text-slate-900 mb-1.5">About this place</h2>
                    <div class="text-slate-600 leading-relaxed text-[13px] sm:text-sm">
                        <p id="listing-description" class="whitespace-pre-wrap wrap-break-word line-clamp-4 transition-all duration-300 ease-in-out"><%= listing.description %></p>
                        
                        <button id="show-more-desc-btn" class="hidden mt-1.5 group items-center gap-1 font-semibold text-slate-900 hover:underline underline-offset-4 cursor-pointer focus:outline-none transition-colors">
                            <span id="show-more-desc-text">Show more</span>
                            <svg id="show-more-desc-icon" class="w-3.5 h-3.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>
                    </div>
                </div>
                <% } %>

                <!-- Action Buttons -->
                <% if(currentUser && listing.author.equals(currentUser._id)) { %>
                    <div class="mt-6 bg-slate-50 border border-slate-200 rounded-xl p-4 sm:p-5">
                        <h3 class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-3">Owner Actions</h3>
                        <div class="flex flex-col sm:flex-row gap-2.5">
                            <a href="/listing/<%= listing._id %>/edit"
                                class="inline-flex items-center justify-center px-4 py-2 bg-slate-900 text-white text-[13px] font-semibold rounded-lg shadow-sm hover:bg-slate-800 focus:ring-4 focus:ring-slate-200 focus:outline-none transition-all duration-200">
                                <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                                Edit Listing
                            </a>

                            <form action="/listing/<%= listing._id %>?_method=DELETE" method="POST" class="m-0">
                                <button type="submit"
                                    class="w-full inline-flex items-center justify-center px-4 py-2 bg-white text-rose-600 border border-rose-200 text-[13px] font-semibold rounded-lg shadow-sm hover:bg-rose-50 hover:border-rose-300 focus:ring-4 focus:ring-rose-100 focus:outline-none transition-all duration-200 cursor-pointer">
                                    <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                    </svg>
                                    Delete Listing
                                </button>
                            </form>
                        </div>
                    </div>
                <% } %>

            </div>

            <!-- RIGHT COLUMN: Map & Review -->
            <div class="lg:col-span-4 space-y-5">

                <!-- Map Location -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-3.5 border-b border-slate-200 bg-slate-50">
                        <h2 class="text-sm font-bold text-slate-900 flex items-center">
                            <svg class="w-4 h-4 mr-1.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                            </svg>
                            Where you'll be
                        </h2>
                    </div>
                    <!-- Map scaled down to 280px -->
                    <div id="map" class="w-full h-64 sm:h-76 bg-slate-100 z-0"></div>
                </div>

                <!-- Add Review Form -->
                <% if(currentUser) { %>
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 sm:p-5">
                        <h2 class="text-base font-bold text-slate-900 mb-3">Share Your Experience</h2>

                        <form action="/listing/<%= listing._id %>/reviews" method="POST" novalidate
                            class="needs-validation group">
                            <div class="mb-2.5">
                                <fieldset class="starability-basic m-0 scale-90 origin-left"
                                    onclick="this.className='starability-growRotate m-0 scale-90 origin-left'">
                                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                                        value="1" aria-label="No rating." />
                                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                    <label for="first-rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                    <label for="first-rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                    <label for="first-rate3" title="Average">3 stars</label>
                                    <input type="radio" id="first-rate4" name="review[rating]" value="4" checked />
                                    <label for="first-rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                            </div>

                            <div class="mb-3.5">
                                <label for="reviewbody" id="bodylabel"
                                    class="block text-[13px] font-semibold text-slate-700 mb-1">Your Experience</label>
                                <textarea name="review[body]" id="reviewbody" cols="40" rows="3"
                                    placeholder="What did you do? Any tips on food or stay?"
                                    class="peer w-full rounded-lg border border-slate-200 p-2.5 text-[13px] text-slate-700 focus:ring-4 focus:ring-slate-100 focus:border-slate-400 focus:outline-none transition-all duration-200 resize-y group-[.was-validated]:invalid:border-rose-500 group-[.was-validated]:valid:border-emerald-500"
                                    maxlength="600" required></textarea>
                                <p
                                    class="hidden group-[.was-validated]:peer-invalid:block text-[10px] text-rose-500 mt-1 font-medium">
                                    Please write about your experience before submitting.
                                </p>
                            </div>

                            <button type="submit"
                                class="w-full inline-flex items-center justify-center px-4 py-2 cursor-pointer bg-slate-900 text-white text-[13px] font-semibold rounded-lg shadow-sm hover:bg-slate-800 focus:ring-4 focus:ring-slate-200 focus:outline-none transition-all duration-200">
                                Share Experience
                            </button>
                        </form>
                    </div>
                    <% } else { %>
                        <div
                            class="bg-slate-50 border border-slate-200 border-dashed rounded-xl p-6 text-center flex flex-col items-center justify-center">
                            <div
                                class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm border border-slate-200 mb-3">
                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z">
                                    </path>
                                </svg>
                            </div>
                            <h3 class="text-sm font-semibold text-slate-900">Want to share your experience?</h3>
                            <p class="text-xs text-slate-500 mt-1 mb-4 max-w-xs mx-auto">
                                Log in to leave a review and help other travelers make great choices.
                            </p>

                            <a href="/login?returnTo=/listing/<%= listing._id %>"
                                class="inline-flex items-center justify-center px-4 py-2 bg-slate-900 text-white text-[13px] font-semibold rounded-lg shadow-sm hover:bg-slate-800 focus:ring-4 focus:ring-slate-200 focus:outline-none transition-all duration-200">
                                Log in to Review
                            </a>
                        </div>
                        <% } %>

            </div>
        </div>

        <!-- Reviews Section -->
        <div class="pt-5 border-t border-slate-200">
            <h2 class="text-lg font-bold text-slate-900 mb-4">
                Traveler Experiences <% if(listing.reviews && listing.reviews.length> 0) { %>(<%= listing.reviews.length
                        %>)<% } %>
            </h2>

            <% if(listing.reviews && listing.reviews.length> 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="reviews-grid">
                    <% listing.reviews.forEach(function(review, index) { %>
                        <div
                            class="review-card bg-white p-4 rounded-xl shadow-sm border border-slate-200 hover:shadow-md transition-shadow duration-300 flex flex-col h-full <%= index >= 6 ? 'hidden' : '' %>">

                            <div class="flex items-start gap-2.5 mb-2.5">
                                <div
                                    class="w-7 h-7 rounded-full bg-slate-900 text-white flex items-center justify-center text-[10px] font-bold uppercase shrink-0 mt-0.5">
                                    <%= review.author.username.charAt(0) %>
                                </div>

                                <div>
                                    <p class="text-[13px] font-bold text-slate-900 leading-none mb-1">
                                        @<%= review.author.username %>
                                    </p>
                                    <div class="h-3.5 flex items-center">
                                        <p class="starability-result scale-[0.55] origin-left m-0"
                                            data-rating="<%= review.rating %>">
                                            Rated: <%= review.rating %> stars
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <p
                                class="text-slate-600 text-[13px] leading-relaxed grow wrap-break-word break-all max-h-32 overflow-y-auto pr-2">
                                <%= review.body %>
                            </p>

                            <% if(currentUser && review.author.equals(currentUser._id)) { %>
                                <form class="mt-3 flex"
                                    action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                    method="POST">
                                    <button type="submit"
                                        class="inline-flex items-center justify-center px-2.5 py-1 bg-white text-rose-600 border border-rose-200 text-[11px] font-semibold rounded-md shadow-sm hover:bg-rose-50 hover:border-rose-300 focus:ring-4 focus:ring-rose-100 focus:outline-none transition-all duration-200 cursor-pointer">
                                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor"
                                            viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                            </path>
                                        </svg>
                                        Remove
                                    </button>
                                </form>
                                <% } %>
                        </div>
                        <% }) %>
                </div>

                <% if(listing.reviews.length > 6) { %>
                    <div class="mt-8 flex justify-center">
                        <button onclick="openReviewsModal()"
                            class="group relative inline-flex items-center justify-center px-6 py-2.5 bg-white border border-slate-200 text-slate-700 text-[13px] font-bold rounded-full shadow-sm hover:border-slate-900 hover:text-slate-900 hover:shadow-md hover:-translate-y-0.5 focus:outline-none focus:ring-4 focus:ring-slate-200 active:translate-y-0 transition-all duration-300 cursor-pointer overflow-hidden">
                            <span>Show all <%= listing.reviews.length %> reviews</span>
                        </button>
                    </div>
                <% } %>

            <% } else { %>
                <div
                    class="bg-slate-50 border border-slate-200 border-dashed rounded-xl p-6 text-center flex flex-col items-center justify-center">
                    <svg class="w-8 h-8 text-slate-400 mb-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                            d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z">
                        </path>
                    </svg>
                    <h3 class="text-[13px] font-semibold text-slate-900">No experiences yet</h3>
                    <p class="text-[13px] text-slate-500 mt-1">Be the first to share your experience!</p>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Reviews Modal -->
    <div id="reviews-modal" class="fixed inset-0 z-120 hidden bg-black/60 flex-col items-center justify-center opacity-0 transition-opacity duration-300 backdrop-blur-sm p-4" onclick="closeReviewsModal(event)">
        <div class="relative w-full max-w-3xl max-h-[85vh] bg-white rounded-2xl overflow-hidden shadow-2xl flex flex-col scale-95 transition-transform duration-300 transform" onclick="event.stopPropagation()">
            <div class="flex items-center justify-between p-4 sm:p-5 border-b border-slate-200 bg-white z-10 relative shadow-sm">
                <h2 class="text-lg font-bold text-slate-900">
                    All <%= listing.reviews.length %> Reviews
                </h2>
                <button onclick="closeReviewsModal(event)" class="p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-full transition-colors focus:outline-none cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <!-- Reviews List -->
            <div class="overflow-y-auto p-4 sm:p-5 pb-10 flex-1 space-y-4 bg-slate-50/50">
                <% listing.reviews.forEach(function(review) { %>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 hover:border-slate-300 transition-colors">
                        <div class="flex items-start gap-2.5 mb-2.5">
                            <div class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center text-xs font-bold uppercase shrink-0">
                                <%= review.author.username.charAt(0) %>
                            </div>
                            <div>
                                <p class="text-[13px] font-bold text-slate-900 leading-none mb-1">
                                    @<%= review.author.username %>
                                </p>
                                <p class="starability-result scale-[0.55] origin-left m-0" data-rating="<%= review.rating %>">
                                    Rated: <%= review.rating %> stars
                                </p>
                            </div>
                        </div>
                        <p class="text-slate-600 text-[13px] leading-relaxed wrap-break-word break-all">
                            <%= review.body %>
                        </p>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <!-- Lightbox (Images) -->
    <div id="lightbox"
        class="fixed inset-0 z-110 hidden bg-black/95 flex-col items-center justify-center opacity-0 transition-opacity duration-300 backdrop-blur-sm"
        onclick="closeLightbox(event)">

        <button onclick="closeLightbox(event)"
            class="absolute top-4 right-4 sm:top-5 sm:right-5 text-white/70 hover:text-white p-2 z-110 focus:outline-none transition-colors cursor-pointer">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>

        <% if (listing.image && listing.image.length> 1) { %>
            <button onclick="prevLightboxSlide(event)"
                class="absolute left-3 top-1/2 -translate-y-1/2 text-white/50 hover:text-white p-2 z-110 focus:outline-none transition-colors cursor-pointer">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
