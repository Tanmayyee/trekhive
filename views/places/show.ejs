<% layout('/layout/boilerplate') %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <a href="/listing"
        class="group inline-flex items-center text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors">
        <svg class="w-4 h-4 mr-1.5 transition-transform duration-300 group-hover:-translate-x-1" fill="none"
            stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18">
            </path>
        </svg>
        Explore all places
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

        <div class="lg:col-span-7 space-y-6">
            
            <div class="relative w-full rounded-xl overflow-hidden bg-slate-100 shadow-sm border border-slate-200 aspect-4/3 group">
                <img src="<%= listing.image %>" alt="<%= listing.title %>"
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-[1.03]">
                <div class="absolute inset-0 bg-linear-to-t from-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </div>

            <div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight uppercase mb-2">
                    <%= listing.title %>
                </h1>
                <div class="flex items-center text-slate-600 font-medium text-sm">
                    <svg class="w-4 h-4 mr-1.5 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z">
                        </path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <%= listing.location %>
                </div>
                <div class="mt-2.5 flex items-center text-sm">
                    <svg class="w-4 h-4 mr-1.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    <span class="text-slate-500 mr-1.5">Listed by</span>
                    <span class="font-semibold text-slate-900"><%= listing.author.username %></span>
                </div>
            </div>

            <div class="text-slate-600 leading-relaxed text-sm sm:text-base">
                <p class="whitespace-pre-line"><%= listing.description %></p>
            </div>

        </div>

        <div class="lg:col-span-5 space-y-6">
            
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 sm:p-6">
                
                <div class="mb-5">
                    <div class="flex items-baseline gap-2 mb-2">
                        <span class="text-2xl font-bold text-slate-900">₹<%= listing.price || "5,000" %></span>
                        <span class="text-sm font-medium text-slate-500">avg / week</span>
                    </div>

                    <div class="flex items-start gap-2 p-2.5 bg-slate-50 rounded-lg border border-slate-100 text-xs sm:text-sm mt-3">
                        <svg class="w-4 h-4 shrink-0 text-amber-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <p class="text-slate-600 leading-relaxed">
                            <span class="font-semibold text-slate-800">Note:</span> 
                            Covers average weekly stay and food. <span class="font-semibold text-slate-700">Travel and tickets are excluded.</span>
                        </p>
                    </div>
                </div>
                
                <% if(currentUser && listing.author.equals(currentUser._id)) { %>
                <div class="flex flex-col sm:flex-row gap-2.5 pt-5 border-t border-slate-100">
                    <a href="/listing/<%= listing._id %>/edit"
                        class="flex-1 inline-flex items-center justify-center px-4 py-2.5 bg-slate-900 text-white text-sm font-semibold rounded-lg shadow-sm hover:bg-slate-800 focus:ring-4 focus:ring-slate-200 focus:outline-none transition-all duration-200">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                        Edit
                    </a>

                    <form action="/listing/<%= listing._id %>?_method=DELETE" method="POST" class="flex-1 m-0 flex">
                        <button type="submit"
                            class="w-full inline-flex items-center justify-center px-4 py-2.5 bg-white text-rose-600 border border-rose-200 text-sm font-semibold rounded-lg shadow-sm hover:bg-rose-50 hover:border-rose-300 focus:ring-4 focus:ring-rose-100 focus:outline-none transition-all duration-200 cursor-pointer">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                            Delete
                        </button>
                    </form>
                </div>
                <% } %>
            </div>
            
            <% if(currentUser) { %>
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 sm:p-6">
                <h2 class="text-lg font-bold text-slate-900 mb-4">Share Your Experience</h2>

                <form action="/listing/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation group space-y-4">
                    
                    <div>
                        <label for="rating" class="block text-sm font-semibold text-slate-700 mb-1.5">Rating</label>
                        <div class="flex items-center gap-3">
                            <input type="range" name="review[rating]" id="rating" min="1" max="5"
                                class="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-slate-900">
                            <span class="text-xs font-medium text-slate-500 shrink-0">1 - 5</span>
                        </div>
                    </div>

                    <div>
                        <label for="reviewbody" id="bodylabel" class="block text-sm font-semibold text-slate-700 mb-1.5">Your Experience</label>
                        <textarea name="review[body]" id="reviewbody" cols="40" rows="3"
                            placeholder="What did you do? Any tips on food or stay?"
                            class="peer w-full rounded-lg border border-slate-200 p-3 text-sm text-slate-700 focus:ring-4 focus:ring-slate-100 focus:border-slate-400 focus:outline-none transition-all duration-200 resize-y group-[.was-validated]:invalid:border-rose-500 group-[.was-validated]:valid:border-emerald-500"
                            required></textarea>
                        <p class="hidden group-[.was-validated]:peer-invalid:block text-[11px] text-rose-500 mt-1 font-medium">
                            Please write about your experience before submitting.
                        </p>
                    </div>

                    <button type="submit"
                        class="w-full inline-flex items-center justify-center px-4 py-2.5 cursor-pointer bg-slate-900 text-white text-sm font-semibold rounded-lg shadow-sm hover:bg-slate-800 focus:ring-4 focus:ring-slate-200 focus:outline-none transition-all duration-200">
                        Share Experience
                    </button>
                </form>
            </div>
            <% }else{ %>
                <div class="bg-slate-50 border border-slate-200 border-dashed rounded-xl p-8 text-center flex flex-col items-center justify-center">
                <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-sm border border-slate-200 mb-4">
                    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-slate-900">Want to share your experience?</h3>
                <p class="text-sm text-slate-500 mt-1 mb-5 max-w-xs mx-auto">
                    Log in to leave a review and help other travelers make great choices.
                </p>

                <!--Passing the current page URL to the login route so we come back here after logging in -->
                <a href="/login?returnTo=/listing/<%= listing._id %>"  
                    class="inline-flex items-center justify-center px-5 py-2.5 bg-slate-900 text-white text-sm font-semibold rounded-lg shadow-sm hover:bg-slate-800 focus:ring-4 focus:ring-slate-200 focus:outline-none transition-all duration-200">
                    Log in to Review
                </a>
            </div>
                <% } %>

        </div>
    </div>

    <div class="pt-6 border-t border-slate-200">
        <h2 class="text-xl font-bold text-slate-900 mb-5">
            Traveler Experiences <% if(listing.reviews && listing.reviews.length > 0) { %>(<%= listing.reviews.length %>)<% } %>
        </h2>
        
        <% if(listing.reviews && listing.reviews.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                <% for(let review of listing.reviews){ %>
                    <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
            
                       <div class="flex items-center gap-3 mb-3">
                           <div class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center text-xs font-bold uppercase shrink-0">
                               <%= review.author.username.charAt(0) %>
                           </div>
                           <div>
                             <p class="text-sm font-bold text-slate-900 mb-2">@<%= review.author.username %></p>                    
                               <div class="flex items-center gap-0.5 mt-1">
                                   <% for(let i = 1; i <= 5; i++) { %>
                                       <svg class="w-3 h-3 <%= i <= review.rating ? 'text-amber-400' : 'text-slate-200' %>" fill="currentColor" viewBox="0 0 20 20">
                                           <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                       </svg>
                                   <% } %>
                               </div>
                           </div>
                       </div>
                        
                        <p class="text-slate-600 text-sm leading-relaxed grow">
                            <%= review.body %>
                        </p>

                      <% if(currentUser && review.author.equals(currentUser._id)) { %>
                        <form class="mt-4 flex" action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                            <button type="submit" class="inline-flex items-center justify-center px-3 py-1.5 bg-white text-rose-600 border border-rose-200 text-xs font-semibold rounded-lg shadow-sm hover:bg-rose-50 hover:border-rose-300 focus:ring-4 focus:ring-rose-100 focus:outline-none transition-all duration-200 cursor-pointer">
                                <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                                Remove
                            </button>
                        </form>
                        <% } %>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="bg-slate-50 border border-slate-200 border-dashed rounded-xl p-8 text-center flex flex-col items-center justify-center">
                <svg class="w-10 h-10 text-slate-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                </svg>
                <h3 class="text-sm font-semibold text-slate-900">No experiences yet</h3>
                <p class="text-sm text-slate-500 mt-1">Be the first to share your trip!</p>
            </div>
        <% } %>
    </div>

</div>

