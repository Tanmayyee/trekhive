<% layout('/layout/boilerplate') %>

<div class="max-w-5xl mx-auto px-4 py-6 space-y-8">
    
    <!-- Top Navigation -->
    <a href="/listing" class="group inline-flex items-center text-sm font-semibold text-slate-500 hover:text-slate-900 transition-colors">
        <svg class="w-4 h-4 mr-1.5 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Explore all treks
    </a>

    <!-- Main Listing Card -->
    <div class="group bg-white rounded-2xl shadow-sm hover:shadow-xl transition-shadow duration-300 overflow-hidden border border-slate-100 flex flex-col md:flex-row md:max-h-[75vh]">
        
        <!-- Image Section -->
        <div class="relative w-full md:w-5/12 h-64 md:h-auto bg-slate-200 shrink-0 overflow-hidden">
            <img 
                src="<%= listing.image %>" 
                alt="<%= listing.title %>" 
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-105"
            >
            <div class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        </div>

        <!-- Content Section -->
        <div class="p-6 md:p-8 flex flex-col grow overflow-hidden">
            
            <!-- Header -->
            <div class="mb-4">
                <h1 class="text-3xl font-extrabold text-transparent bg-clip-text bg-linear-to-r from-slate-900 to-slate-600 uppercase tracking-tight mb-1.5">
                    <%= listing.title %>
                </h1>
                <div class="flex items-center text-slate-500 text-sm font-medium">
                    <svg class="w-4 h-4 mr-1 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <%= listing.location %>
                </div>
            </div>

            <!-- Estimated Cost Section -->
            <div class="mb-5 bg-slate-50 rounded-xl border border-slate-100 p-4 shrink-0">
                <div class="flex items-baseline gap-1.5 mb-2">
                    <span class="text-sm font-semibold text-slate-500">Est. Cost:</span>
                    <span class="text-2xl font-black text-slate-900">₹<%= listing.price || "5,000" %></span>
                    <span class="text-sm font-medium text-slate-500">/ person</span>
                </div>
                
                <div class="flex items-start gap-1.5 text-xs leading-relaxed">
                    <svg class="w-4 h-4 shrink-0 text-amber-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <p class="text-slate-600">
                        <span class="font-semibold text-slate-800">Note:</span> Covers local expenses (like stay, food) for the week.<span class="font-bold text-slate-600"> No travel/flight expenses.</span>
                    </p>
                </div>
            </div>

            <!-- Description -->
            <div class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6 overflow-y-auto pr-3 grow scrollbar-thin scrollbar-thumb-slate-200 scrollbar-track-transparent">
                <p><%= listing.description %></p>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-3 pt-5 border-t border-slate-100 mt-auto shrink-0">
                <a 
                    href="/listing/<%= listing._id %>/edit" 
                    class="inline-flex items-center justify-center px-6 py-2.5 bg-slate-900 text-white text-sm font-semibold rounded-lg shadow-sm hover:bg-slate-800 hover:shadow-md focus:ring-4 focus:ring-slate-200 focus:outline-none active:scale-95 transition-all duration-200"
                >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    Edit Trek
                </a>
                
                <form action="/listing/<%= listing._id %>?_method=DELETE" method="POST" class="m-0">
                    <button 
                        type="submit" 
                        class="inline-flex items-center justify-center px-6 py-2.5 bg-white text-rose-600 border border-rose-200 text-sm font-semibold rounded-lg shadow-sm hover:bg-rose-50 hover:border-rose-300 focus:ring-4 focus:ring-rose-100 focus:outline-none active:scale-95 transition-all duration-200 cursor-pointer"
                    >
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        Delete
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Review Section Container -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 md:p-8">
        <h2 class="text-2xl font-extrabold text-slate-900 mb-6">Leave a Review</h2>
        
        <!-- Review Form: Added novalidate and validation classes -->
        <form action=""  novalidate class="needs-validation group max-w-2xl space-y-5">
            
            <!-- Rating Input (Range inputs don't typically fail validation unless manipulated, so it remains largely the same) -->
            <div>
                <label for="rating" class="block text-sm font-semibold text-slate-700 mb-2">Rating</label>
                <div class="flex items-center gap-4">
                    <input 
                        type="range" 
                        name="review[rating]" 
                        id="rating" 
                        min="1" 
                        max="5" 
                        class="w-full sm:w-64 h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-slate-900"
                    >
                    <span class="text-sm font-medium text-slate-500">1 to 5</span>
                </div>
            </div>

            <!-- Review Body Input -->
            <div>
                <label for="body" id="bodylabel" class="block text-sm font-bold text-slate-700 mb-2">Your Review</label>
                <!-- Added 'peer' and the group-validation color classes -->
                <textarea 
                    name="review[body]" 
                    id="reviewbody" 
                    cols="40" 
                    rows="4" 
                    placeholder="Share details of your experience at this trek..."
                    class="peer w-full rounded-xl border border-slate-200 p-4 text-slate-700 focus:ring-4 focus:ring-slate-100 focus:border-slate-400 focus:outline-none transition-all duration-200 resize-y group-[.was-validated]:invalid:border-rose-500 group-[.was-validated]:invalid:focus:ring-rose-500 group-[.was-validated]:valid:border-emerald-500 group-[.was-validated]:valid:focus:ring-emerald-500"
                    required
                ></textarea>
                <!-- Added Error Message -->
                <p class="hidden group-[.was-validated]:peer-invalid:block text-[11px] text-rose-500 mt-1 font-medium">Please provide a review before submitting.</p>
            </div>

            <!-- Submit Button -->
            <button 
                type="submit" 
                class="inline-flex items-center justify-center px-6 py-2.5 bg-slate-900 text-white text-sm font-semibold rounded-lg shadow-sm hover:bg-slate-800 hover:shadow-md focus:ring-4 focus:ring-slate-200 focus:outline-none active:scale-95 transition-all duration-200"
            >
                Submit Review
            </button>
        </form>
    </div>

</div>