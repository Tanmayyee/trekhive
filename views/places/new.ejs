  <% layout('/layout/boilerplate') %>

    <form action="/listing" method="POST" class="p-5">
        <div class="mb-2">
            <label for="title" id="title">Title:</label>
            <input type="text" name="listing[title]" id="title" class="border" >
        </div>
        <div>
            <label for="location" id="location">Location:</label>
            <input type="text" name="listing[location]" id="location" class="border">
        </div>
        <br>
        <button class="border bg-slate-200 py-1 px-2 "> Add to Trekhive </button>
        <br>
        <a href="/listing">Cancel</a>
    </form>
