<% layout('/layout/boilerplate') %>

    <div class="flex items-center justify-center px-4 sm:px-6 lg:px-8 py-4 min-h-[80vh]">

        <div class="max-w-xl w-full bg-white border border-slate-200 border-t-4 border-t-green-600 rounded-2xl shadow-xl shadow-slate-900/5 p-4 sm:p-5 transition-all duration-300">

            <!-- Header - Reduced margin-bottom from mb-5 to mb-4 -->
            <div class="mb-4 text-center sm:text-left">
                <h1 class="text-xl sm:text-2xl font-extrabold uppercase text-slate-900 tracking-tight">
                    Add a New Trek
                </h1>
                <p class="text-xs sm:text-sm text-slate-500 mt-1">Fill in the details below to list a new adventure on Trekhive.
                </p>
            </div>

            <!-- Form -->
            <form action="/listing" method="POST" class="flex flex-col gap-3">
                
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                   <!-- title -->
                  <div>
                      <label for="title" class="block text-[13px] font-bold text-slate-700 mb-1">
                          Trek Title
                      </label>
                      <input type="text" name="listing[title]" id="title" placeholder="e.g., Kedarkantha Summit" required
                          class="w-full px-3 py-1.5 rounded-lg border border-slate-300 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all duration-200">
                  </div>

                   <!-- Location -->
                  <div>
                      <label for="location" class="block text-[13px] font-bold text-slate-700 mb-1">
                          Location
                      </label>
                      <input type="text" name="listing[location]" id="location" placeholder="e.g., Uttarakhand, India"
                          required
                          class="w-full px-3 py-1.5 rounded-lg border border-slate-300 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all duration-200">
                  </div>
              </div>
                <!-- Title -->
                

                <!-- image -->
                <div>
                    <label for="image" class="block text-[13px] font-bold text-slate-700 mb-1">
                        Image
                    </label>
                    <input type="text" name="listing[image]" id="image" placeholder="e.g., https://unsplash.com"
                        class="w-full px-3 py-1.5 rounded-lg border border-slate-300 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all duration-200">
                    <p class="text-[11px] sm:text-xs text-slate-500 mt-1">Paste a high-quality image link of the trek.</p>
                </div>

                <!-- estimated cost -->
                <div>
                    <label for="price" class="block text-[13px] font-bold text-slate-700 mb-1">
                        Estimated Cost
                    </label>   
                    <div
                        class="flex rounded-lg border border-slate-300 focus-within:ring-2 focus-within:ring-slate-900 focus-within:border-transparent transition-all duration-200">
                        <span
                            class="inline-flex items-center px-3 py-1.5 text-sm bg-slate-100 text-slate-600 font-bold border-r border-slate-300 rounded-l-lg ">
                            ₹
                        </span>
                        
                        <input type="number" name="listing[price]" id="price" placeholder="e.g. 1500" min="0" required
                            class="w-full px-3 py-1.5 rounded-r-lg text-sm text-slate-900 placeholder-slate-400 e.g. 5000 focus:outline-none">
                    </div>

                    <div class="mt-1 flex items-start gap-1.5">
                        <svg class="w-3.5 h-3.5 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <p class="text-[12px] text-slate-500 leading-tight">
                           Only enter the on-ground trekking cost (like stay, food) for the week. <span class="font-bold text-slate-600">No travel/flight expenses.</span>
                        </p>
                    </div>
                </div>

                <!-- description -->
                <div>
                    <label for="description" class="block text-[13px] font-bold text-slate-700 mb-1">
                        Description
                    </label>
                    <textarea type="text" name="listing[description]" id="description" rows="3"
                        placeholder="Describe the trek highlights, difficulty, and itinerary..."
                        class="w-full px-3 py-1.5 rounded-lg border border-slate-300 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all duration-200"></textarea>
                </div>

                <!-- Action Buttons -->
                <div
                    class="flex flex-col-reverse sm:flex-row items-center justify-between gap-3 pt-3 mt-1 border-t border-slate-100">
                    <a href="/listing"
                        class="w-full sm:w-auto text-center px-5 py-2 text-sm font-semibold text-slate-600 hover:text-slate-900 transition-colors duration-200">
                        Cancel
                    </a>

                    <button 
                        class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-bold cursor-pointer rounded-xl shadow-md hover:shadow-lg active:scale-95 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2">
                        Add to Trekhive
                    </button>
                </div>

            </form>
        </div>
    </div>