<% layout('/layout/boilerplate') %>

    <!-- Reduced container padding from py-6 to py-4 and added min-h-[85vh] for centering -->
    <div class="flex items-center justify-center px-4 sm:px-6 lg:px-8 py-4 min-h-[85vh]">

        <!-- Added border-t-4 border-t-green-600 to match the "Add to Trekhive" button -->
        <div class="max-w-xl w-full bg-white border border-slate-200 border-t-4 border-t-green-600 rounded-2xl shadow-xl shadow-slate-900/5 p-4 sm:p-5 transition-all duration-300">

            <!-- Header - Reduced margin-bottom from mb-5 to mb-4 -->
            <div class="mb-4 text-center sm:text-left">
                <h1 class="text-xl sm:text-2xl font-extrabold uppercase text-slate-900 tracking-tight">
                    Add a New Trek
                </h1>
                <p class="text-xs sm:text-sm text-slate-500 mt-1">Fill in the details below to list a new adventure on Trekhive.
                </p>
            </div>

            <!-- Reduced gap between inputs from space-y-4 to space-y-3 -->
            <form action="/listing" method="POST" class="space-y-3">

                <!-- Title -->
                <div>
                    <label for="title" class="block text-sm font-bold text-slate-700 mb-1">
                        Trek Title
                    </label>
                    <input type="text" name="listing[title]" id="title" placeholder="e.g., Kedarkantha Summit" required
                        class="w-full px-3 py-1.5 sm:py-2 rounded-lg border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all duration-200">
                </div>

                <!-- Location -->
                <div>
                    <label for="location" class="block text-sm font-bold text-slate-700 mb-1">
                        Location
                    </label>
                    <input type="text" name="listing[location]" id="location" placeholder="e.g., Uttarakhand, India"
                        required
                        class="w-full px-3 py-1.5 sm:py-2 rounded-lg border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all duration-200">
                </div>

                <!-- image -->
                <div>
                    <label for="image" class="block text-sm font-bold text-slate-700 mb-1">
                        Image
                    </label>
                    <input type="text" name="listing[image]" id="image" placeholder="e.g., https://unsplash.com"
                        required
                        class="w-full px-3 py-1.5 sm:py-2 rounded-lg border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all duration-200">
                    <p class="text-[11px] sm:text-xs text-slate-500 mt-1">Paste a high-quality image link of the trek.</p>
                </div>

                <!-- estimated cost -->
                <div>
                    <label for="price" class="block text-sm font-bold text-slate-700 mb-1">
                        Estimated Cost
                    </label>   
                    <div
                        class="flex rounded-lg border border-slate-300 focus-within:ring-2 focus-within:ring-slate-900 focus-within:border-transparent transition-all duration-200">
                        <span
                            class="inline-flex items-center px-3 py-1.5 sm:py-2 bg-slate-100 text-slate-600 font-bold border-r border-slate-300 rounded-l-lg">
                            ₹
                        </span>
                        <!-- Removed step="100" and fixed padding to match other fields (px-3 py-1.5 sm:py-2) -->
                        <input type="number" name="listing[price]" id="price" placeholder="e.g. 1500" min="0" required
                            class="w-full px-3 py-1.5 sm:py-2 rounded-r-lg text-slate-900 placeholder-slate-400 focus:outline-none">
                    </div>
                </div>

                <!-- description -->
                <div>
                    <label for="description" class="block text-sm font-bold text-slate-700 mb-1">
                        Description
                    </label>
                    <textarea type="text" name="listing[description]" id="description" rows="2"
                        placeholder="Describe the trek highlights, difficulty, and itinerary..."
                        class="w-full px-3 py-1.5 sm:py-2 rounded-lg border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all duration-200"></textarea>
                </div>

                <!-- Action Buttons -->
                <div
                    class="flex flex-col-reverse sm:flex-row items-center justify-between gap-3 pt-2 border-t border-slate-100">
                    <a href="/listing"
                        class="w-full sm:w-auto text-center px-5 py-2 text-sm font-semibold text-slate-600 hover:text-slate-900 transition-colors duration-200">
                        Cancel
                    </a>

                    <button 
                        class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-bold rounded-xl shadow-md hover:shadow-lg active:scale-95 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2">
                        Add to Trekhive
                    </button>
                </div>

            </form>
        </div>
    </div>