<% layout('/layout/boilerplate') %>

<div class="flex items-center justify-center px-4 py-8 min-h-[80vh]">

    <div class="max-w-[24rem] w-full bg-white rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.06)] border border-slate-100 p-8 transition-all duration-300">

        <!-- Header -->
        <div class="text-center mb-7">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-green-50 mb-3.5">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
            </div>
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                Welcome Back
            </h1>
            <p class="text-sm text-slate-500 mt-1">
                Log in to continue your adventure on Trekhive.
            </p>
        </div>

        <!-- Form -->
        <form action="/login" method="POST" novalidate class="needs-validation group flex flex-col gap-5 text-left">
            
            <!-- Username -->
            <div>
                <label for="username" class="block text-xs font-bold text-slate-700 mb-1.5 ml-1">
                    Username
                </label>
                <input type="text" name="username" id="username" placeholder="trekker_john" required
                    class="peer w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-transparent transition-all duration-200 group-[.was-validated]:invalid:border-rose-500 group-[.was-validated]:invalid:focus:ring-rose-500 group-[.was-validated]:valid:border-emerald-500 group-[.was-validated]:valid:focus:ring-emerald-500">
                <p class="hidden group-[.was-validated]:peer-invalid:block text-[11px] text-rose-500 mt-1.5 ml-1 font-medium">
                    Please enter your username.
                </p>
            </div>
            
            <!-- password -->
            <div>
                <label for="password" class="block text-xs font-bold text-slate-700 mb-1.5 ml-1">
                    Password
                </label>
                <input type="password" name="password" id="password" placeholder="••••••••" required
                    class="peer w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-transparent transition-all duration-200 group-[.was-validated]:invalid:border-rose-500 group-[.was-validated]:invalid:focus:ring-rose-500 group-[.was-validated]:valid:border-emerald-500 group-[.was-validated]:valid:focus:ring-emerald-500">
                <p class="hidden group-[.was-validated]:peer-invalid:block text-[11px] text-rose-500 mt-1.5 ml-1 font-medium">
                    Please enter your password.
                </p>
            </div>

            <button 
                class="w-full mt-1.5 inline-flex items-center cursor-pointer justify-center px-5 py-3 bg-slate-900 hover:bg-slate-800 text-white text-sm font-bold rounded-xl shadow-lg shadow-slate-900/20 active:scale-[0.98] transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2">
                Log In
            </button>

        </form>

        <div class="mt-7 text-center text-sm text-slate-500 border-t border-slate-100 pt-5">
            Don't have an account? 
            <a href="/register" class="font-bold text-green-600 hover:text-green-700 transition-colors cursor-pointer">
                Sign up here
            </a>
        </div>

    </div>
</div>